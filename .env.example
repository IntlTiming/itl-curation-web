DATABASE_URL="postgresql://itl:itl@localhost:5432/itl_curation"
PORT=3000
NODE_ENV=development

# Frontend origin, used to redirect back to after Discord OAuth completes.
# Leave unset (or "") in production, where Nest serves the frontend itself
# and a relative redirect is correct.
WEB_ORIGIN=http://localhost:5173

# Discord OAuth2 application (https://discord.com/developers/applications).
# Register DISCORD_CALLBACK_URL below as a redirect URI on the application.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/discord/callback

# Signs the session cookie's JWT. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Comma-separated Discord user IDs granted isGlobalAdmin on login.
GLOBAL_ADMIN_DISCORD_IDS=95626481656410112,282047628458328065,382946737586962432
